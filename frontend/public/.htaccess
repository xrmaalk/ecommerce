Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Missing hashed assets must return 404 instead of the SPA HTML document.
  RewriteRule ^assets/ - [L]
  # Archives SEO: serve the Django sitemap and robots instead of the SPA shell.
  RewriteCond %{HTTP_HOST} ^organicarchives\.organicemperor\.com$ [NC]
  RewriteRule ^sitemap\.xml$ https://api.organicemperor.com/site/archives/sitemap.xml [P,L]
  RewriteCond %{HTTP_HOST} ^organicarchives\.organicemperor\.com$ [NC]
  RewriteRule ^robots\.txt$ https://api.organicemperor.com/site/archives/robots.txt [P,L]
  # These fixed upstreams serve the Vue shell with public metadata for EVERY visitor.
  # Hosting must enable HTTPS reverse proxying (see docs/SEO_DEPLOYMENT.md).
  RewriteCond %{HTTP_HOST} ^(www\.)?organicemperor\.com$ [NC]
  RewriteRule ^products/([A-Za-z0-9_-]+)/$ https://organicemperor.com/products/$1 [R=308,L]
  RewriteCond %{HTTP_HOST} ^organicarchives\.organicemperor\.com$ [NC]
  RewriteRule ^posts/([A-Za-z0-9_-]+)/$ https://organicarchives.organicemperor.com/posts/$1 [R=308,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?organicemperor\.com$ [NC]
  RewriteRule ^products/([A-Za-z0-9_-]+)$ https://api.organicemperor.com/site/storefront/products/$1 [P,L]
  RewriteCond %{HTTP_HOST} ^organicarchives\.organicemperor\.com$ [NC]
  RewriteRule ^posts/([A-Za-z0-9_-]+)$ https://api.organicemperor.com/site/archives/posts/$1 [P,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?organicemperor\.com$ [NC]
  RewriteRule ^products/ - [R=404,L]
  RewriteCond %{HTTP_HOST} ^organicarchives\.organicemperor\.com$ [NC]
  RewriteRule ^posts/ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed bundles can be cached; the entry point must discover every new hash.
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
