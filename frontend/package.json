{
  "name": "organic-emperor-storefront",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "build": "npm run typecheck && vite build",
    "build:all": "npm run typecheck && vite build && vite build --config vite.archives.config.ts",
    "preview": "vite preview",
    "dev:archives": "vite --config vite.archives.config.ts",
    "build:archives": "npm run typecheck && vite build --config vite.archives.config.ts",
    "preview:archives": "vite preview --config vite.archives.config.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2",
    "pinia": "3.0.3",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "6.0.1",
    "jsdom": "^30.1.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue-tsc": "3.0.6"
  }
}
